<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="923d6eb7-2e39-4a92-befa-e3c8533706d8" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2021.1/project-config.xsd">
  <name>Build</name>
  <description />
  <settings>
    <options>
      <option name="artifactRules" value="build/*" />
    </options>
    <parameters>
      <param name="vsn_platform" value="invalid" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_21" name="Convert" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_translations%" />
          <param name="script.content"><![CDATA[set -e

QT_BASE_DIR=/opt/qt54
export QTDIR=$QT_BASE_DIR
export PATH=$QT_BASE_DIR/bin:$PATH

bash ./release.sh]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="MultiMC_Launcher_Translations_MultiMC5translate" />
    </vcs-settings>
    <requirements />
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <cleanup />
  </settings>
</build-type>

