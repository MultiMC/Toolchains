<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="c932d55d-dc84-4726-8146-ec6d14f3c079" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2021.1/project-config.xsd">
  <name>Patreon Credits</name>
  <description />
  <settings>
    <parameters>
      <param name="env.AWS_ACCESS_KEY_ID" value="%s3_deploy_key%" />
      <param name="env.AWS_SECRET_ACCESS_KEY" value="%s3_deploy_secret%" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_11" name="Update patreon stuff" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_deployer%" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="plugin.docker.run.parameters" value="-v /etc/private/deployer:/private -v /home/http/files:/deploy/files" />
          <param name="script.content"><![CDATA[mkdir -p out
patronupdater.py -c /private -w `pwd`/out
cat out/patrons.txt]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_12" name="Deploy" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_deployer%" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="rsync -rvog --chown=33:33 out/patrons.txt /deploy/files/patrons.txt" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_13" name="Sync to s3" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_deployer%" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="s3cmd sync -v --delete-removed /deploy/files/ s3://files.multimc.org/" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings />
    <requirements />
    <build-triggers>
      <build-trigger id="TRIGGER_2" type="schedulingTrigger">
        <parameters>
          <param name="cronExpression_dm" value="*" />
          <param name="cronExpression_dw" value="?" />
          <param name="cronExpression_hour" value="*" />
          <param name="cronExpression_min" value="0" />
          <param name="cronExpression_month" value="*" />
          <param name="cronExpression_sec" value="0" />
          <param name="cronExpression_year" value="*" />
          <param name="dayOfWeek" value="Sunday" />
          <param name="enableQueueOptimization" value="true" />
          <param name="hour" value="12" />
          <param name="minute" value="0" />
          <param name="promoteWatchedBuild" value="true" />
          <param name="revisionRule" value="lastFinished" />
          <param name="revisionRuleBuildBranch" value="&lt;default&gt;" />
          <param name="schedulingPolicy" value="daily" />
          <param name="timezone" value="SERVER" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <cleanup />
  </settings>
</build-type>

