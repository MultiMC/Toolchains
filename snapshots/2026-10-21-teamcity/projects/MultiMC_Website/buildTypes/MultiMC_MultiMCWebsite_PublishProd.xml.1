<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="a7ca1ae1-107e-4268-8bf1-f02e5361b4db" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2021.1/project-config.xsd">
  <name>Publish Prod</name>
  <description />
  <settings>
    <options>
      <option name="allowPersonalBuildTriggering" value="false" />
      <option name="buildConfigurationType" value="DEPLOYMENT" />
      <option name="maximumNumberOfBuilds" value="1" />
    </options>
    <parameters>
      <param name="env.AWS_ACCESS_KEY_ID" value="%s3_deploy_key%" />
      <param name="env.AWS_SECRET_ACCESS_KEY" value="%s3_deploy_secret%" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_10" name="Upload to prod" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_deployer%" />
          <param name="script.content"><![CDATA[cd deploy
s3cmd --delete-removed sync . s3://multimc.org]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings />
    <requirements />
    <build-triggers />
    <artifact-dependencies>
      <dependency id="ARTIFACT_DEPENDENCY_1" sourceBuildTypeId="MultiMC_MultiMCWebsite_Build" cleanDestination="false">
        <revisionRule name="lastSuccessful" revision="latest.lastSuccessful" />
        <artifact sourcePath="site/public =&gt; deploy" />
      </dependency>
    </artifact-dependencies>
    <cleanup />
  </settings>
</build-type>

