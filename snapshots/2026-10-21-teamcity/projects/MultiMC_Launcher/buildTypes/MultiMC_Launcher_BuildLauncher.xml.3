<?xml version="1.0" encoding="UTF-8"?>
<template xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="7d2490d2-5444-4b73-8e5e-29091b03e54e" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2021.1/project-config.xsd">
  <name>Build Launcher</name>
  <settings>
    <options>
      <option name="artifactRules" value="%artifact_prefix%/*" />
      <option name="buildNumberPattern" value="%dep.MultiMC_Launcher_GenerateBuildNumber.build.number%" />
      <option name="publishArtifactCondition" value="SUCCESSFUL" />
    </options>
    <parameters>
      <param name="JOIN" value="" spec="text display='normal' description='The character for joining multiline commands in a shell.' validationMode='any'" />
      <param name="artifact_prefix" value="%system.teamcity.build.checkoutDir%/artifacts" />
      <param name="buildFolder" value="build" />
      <param name="build_type" value="Release" />
      <param name="cmake_command" value="cmake" />
      <param name="cmake_extra_args" value="" />
      <param name="env.LAUNCHER_VERSION" value="0.0.0" />
      <param name="install_prefix" value="%parent_install_prefix%/%root_name%" />
      <param name="make_cmd" value="make" />
      <param name="parent_install_prefix" value="%system.teamcity.build.checkoutDir%/install" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_1" name="Configure" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content"><![CDATA[%cmake_command% %JOIN%
 -DCMAKE_C_COMPILER=%c_compiler% %JOIN%
 -DCMAKE_CXX_COMPILER=%cxx_compiler% %JOIN%
 -DCMAKE_BUILD_TYPE=%build_type% %JOIN%
 -DLauncher_NOTIFICATION_URL:STRING=%multimc.notifications_url% %JOIN%
 -DCMAKE_INSTALL_PREFIX:PATH="%install_prefix%" %JOIN%
 -DCMAKE_PREFIX_PATH="%qt_path%" %JOIN%
 -DQt5_DIR="%qt_path%" %JOIN%
 -DLauncher_UPDATER_BASE=%multimc.update.urlBase% %JOIN%
 -DLauncher_PASTE_EE_API_KEY:STRING=%multimc.paste_ee.api_key% %JOIN%
 -DLauncher_ANALYTICS_ID:STRING=%multimc.analytics_id% %JOIN%
 -DLauncher_LAYOUT=%layout% %JOIN%
 -DLauncher_VERSION_BUILD=%build.number% %JOIN%
 -DLauncher_BUILD_PLATFORM=%vsn_platform% %JOIN%
 -DLauncher_SUBREDDIT_URL=%url_reddit% %JOIN%
 -DLauncher_DISCORD_URL=%url_discord% %JOIN%
 -DLauncher_BUG_TRACKER_URL=%url_bugs% %JOIN%
 -DLauncher_EMBED_SECRETS=On %JOIN%
 %cmake_extra_args% %JOIN%
 ..]]></param>
          <param name="teamcity.build.workingDir" value="%buildFolder%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_15" name="Extract Version" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="%make_cmd% tcversion" />
          <param name="teamcity.build.workingDir" value="%buildFolder%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_2" name="Build" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="%make_cmd% -j%teamcity.agent.hardware.cpuCount%" />
          <param name="teamcity.build.workingDir" value="%buildFolder%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_3" name="Test" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="%make_cmd% test" />
          <param name="teamcity.build.workingDir" value="%buildFolder%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_5" name="Clean install dir" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_windows%" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="%cmake_command% -E remove_directory &quot;%install_prefix%&quot;" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_4" name="Install" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_windows%" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="%make_cmd% install" />
          <param name="teamcity.build.workingDir" value="%buildFolder%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_8" name="Package" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imageId" value="%container_windows%" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content"><![CDATA[%cmake_command% -E remove_directory "%artifact_prefix%"
%cmake_command% -E make_directory "%artifact_prefix%"
%cmake_command% -E tar "cfvz" "%artifact_prefix%/package.tar.gz" "%root_name%"]]></param>
          <param name="teamcity.build.workingDir" value="%parent_install_prefix%" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="MultiMC" />
      <vcs-entry-ref root-id="MultiMC_Secrets">
        <checkout-rule rule="+:. =&gt; ./secrets/" />
      </vcs-entry-ref>
    </vcs-settings>
    <requirements />
    <build-triggers />
    <build-extensions>
      <extension id="BUILD_EXT_1" type="commit-status-publisher">
        <parameters>
          <param name="github_authentication_type" value="token" />
          <param name="github_host" value="https://api.github.com" />
          <param name="publisherId" value="githubStatusPublisher" />
          <param name="secure:github_access_token" value="credentialsJSON:fabaca01-afd2-48c1-877c-450dfab522b2" />
        </parameters>
      </extension>
    </build-extensions>
    <dependencies>
      <depend-on sourceBuildTypeId="MultiMC_Launcher_GenerateBuildNumber">
        <options>
          <option name="run-build-if-dependency-failed" value="CANCEL" />
          <option name="run-build-if-dependency-failed-to-start" value="CANCEL" />
        </options>
      </depend-on>
    </dependencies>
    <cleanup />
  </settings>
</template>

