# Defaults for the Launcher builds. Every setting the build scripts use is listed here.
#
# Override with a config file of the same KEY=value form (--config FILE, for every script)
# or with environment variables. Precedence: environment > config file > this file.
# A config file may only set settings listed here. Values may be quoted and may use
# $TOOLCHAINS (the Toolchains directory), $HOME and settings defined before them.
# Read by common.load_settings; every setting is also passed into the build containers.

# Source
LAUNCHER_REPO=https://github.com/MultiMC/Launcher.git
LAUNCHER_BRANCH=develop

# Platforms built by release-build.py, in this order
PLATFORMS="lin64 lin32 win32 osx64-5.15.2"

# Toolchain images, built from ../containers/<name>
IMAGE_LIN64=multimc/toolchains/linux-x64:dev
IMAGE_LIN32=multimc/toolchains/linux-x32:dev
IMAGE_WIN32=multimc/toolchains/windows-win32:dev
IMAGE_OSX64=multimc/toolchains/macos-osx64:dev

# Build
# 1 = start from an empty build tree; 0 = reuse it (incremental; release-build.py --incremental)
CLEAN=1
BUILD_TYPE=Release
# Parallel jobs per platform build; empty = number of CPUs
JOBS=
# macOS minimum version (CMAKE_OSX_DEPLOYMENT_TARGET)
OSX_DEPLOYMENT_TARGET=10.13
# Extra arguments added to every CMake configure (word-split)
CMAKE_EXTRA_ARGS=

# Values compiled into the Launcher (Launcher_* CMake options)
NOTIFICATION_URL=https://files.multimc.org/notifications.json
UPDATER_BASE=https://files.multimc.org/update/
# NOTE: the next three are currently ignored: the Launcher's CMakeLists.txt sets them with
# a plain set(), which overrides -D. Passed anyway, as TeamCity did, so they take effect if
# the Launcher makes them cache options.
SUBREDDIT_URL=https://www.reddit.com/r/MultiMC/
DISCORD_URL=https://discord.gg/multimc
BUG_TRACKER_URL=https://github.com/MultiMC/Launcher/issues

# Build numbers: a file holding the last number used (release-build.py takes the next).
# Not created automatically: seed it with the last number used on the system it builds for.
BUILD_COUNTER=$TOOLCHAINS/automation/state/build-number
# Where release-build.py puts releases by default: RELEASES_DIR/<build number>
RELEASES_DIR=$TOOLCHAINS/automation/state/releases

# hopper (hopper.py): its record of handled commits (logs go next to it, in .logs/), and
# how often `hopper.py watch` looks at the branch, in seconds
HOPPER_STATE=$TOOLCHAINS/automation/state/hopper.json
WATCH_INTERVAL=60

# Compatibility gate references (compat-check.py): the shipped packages, as downloaded
BASELINES=$TOOLCHAINS/snapshots/2026-10-21-deth001/downloads

# Deploy (deploy.py, publish.py, files-pull.py)
# The image with repoman and rclone (../containers/deployer)
IMAGE_DEPLOYER=multimc/toolchains/deployer:dev
# The local copy of files.multimc.org (update channels, file store, downloads)
FILES_ROOT=$TOOLCHAINS/automation/state/files
# Where files-pull.py copies it from and publish.py copies to (the live tree on deth001)
FILES_ORIGIN=root@deth001.multimc.org:/home/http/files/
# Owner and mode of files publish.py copies to FILES_ORIGIN (as TeamCity's repoman left them)
FILES_ORIGIN_OWNER=http:http
FILES_ORIGIN_MODE=664
# The bucket holding a copy of the tree (R2), as an rclone remote:path, and the rclone config
# with its key (never in this repo). Production's bucket doesn't exist yet: until it is set,
# publish.py refuses to run without --no-bucket.
BUCKET_CONFIG=$HOME/.config/multimc-deploy/rclone.conf
BUCKET_TARGET=
# Where the files tree is served (through Cloudflare); publish.py purges the release's URLs
# there from Cloudflare's cache
PUBLIC_URL=https://files.multimc.org/
# The multimc.org zone, and a file with an API token that may purge its cache (Zone / Cache
# Purge; never in this repo)
CLOUDFLARE_ZONE_ID=d1d77156101ca46f250b45a8e8d45fe7
CLOUDFLARE_TOKEN=$HOME/.config/multimc-deploy/cloudflare-token
