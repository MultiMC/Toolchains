# The parallel test system: files2.multimc.org, set up like production. deth001 serves the
# live tree (/home/http/files2, Caddy site files2.multimc.org); the R2 bucket multimc-files2
# holds a copy, as production's bucket will, and serves it at files2-r2.multimc.org
# (custom domain, r2.dev off). Nothing else writes to it. Use with --config for every script.
#
# Builds made with this config update from files2 only (UPDATER_BASE, NOTIFICATION_URL),
# so they test the whole path without touching files.multimc.org.

FILES_ROOT=$TOOLCHAINS/automation/state/files2
FILES_ORIGIN=root@deth001.multimc.org:/home/http/files2/
BUCKET_TARGET=r2:multimc-files2
PUBLIC_URL=https://files2.multimc.org/
UPDATER_BASE=https://files2.multimc.org/update/
NOTIFICATION_URL=https://files2.multimc.org/notifications.json
TRANSLATIONS_BASE_URL=https://files2.multimc.org/translations/
# files2 numbers its builds separately (seeded at 5002, its last build on 2026-10-23)
BUILD_COUNTER=$TOOLCHAINS/automation/state/build-number-files2
RELEASES_DIR=$TOOLCHAINS/automation/state/releases-files2
HOPPER_STATE=$TOOLCHAINS/automation/state/hopper-files2.json
# The Patreon credits are production's only: one token, one machine
PATRONS_CONFIG=
# The website is production's only
WEBSITE_REPO=
